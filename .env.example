# ==============================================================================
# Live Drop — Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development and fill in the values.
# Never commit .env.local or real secrets to source control.
# Everything here works on free tiers: PayPal Sandbox, Gemini free tier, etc.

# ------------------------------------------------------------------------------
# 1. Application URL
# ------------------------------------------------------------------------------
# Base URL used for email verification links and OAuth callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Secrets you generate yourself
# ------------------------------------------------------------------------------
# Generate each with: openssl rand -base64 32
# Signs login sessions (JWT, HMAC-SHA256).
AUTH_SECRET="your-secure-auth-secret-min-32-chars-long"
# Signs AI shopping agents' permission slips.
AGENT_SLIP_SECRET="another-random-secret-min-32-chars-long"

# ------------------------------------------------------------------------------
# 3. Database
# ------------------------------------------------------------------------------
# MongoDB (Atlas free tier works). Atlas -> Connect -> Drivers -> copy the URI.
MONGODB_URI="mongodb+srv://<cluster-host>/?retryWrites=true&w=majority"
# Optional: credentials kept out of the URI (they replace any user:password in it).
MONGODB_USERNAME=""
MONGODB_PASSWORD=""
# Optional: database name. Defaults to the one in the URI path, else "livedrop".
MONGODB_DB=""

# ------------------------------------------------------------------------------
# 4. PayPal (Sandbox — test money only)
# ------------------------------------------------------------------------------
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your app.
# In the app settings, enable: Vault (save payment methods), Invoicing,
# and Transaction search.
PAYPAL_CLIENT_ID="your-sandbox-client-id"
PAYPAL_CLIENT_SECRET="your-sandbox-secret"
PAYPAL_ENVIRONMENT="sandbox"
# From the app's Webhooks section (needed to verify webhook signatures).
PAYPAL_WEBHOOK_ID=""

# ------------------------------------------------------------------------------
# 5. AI — Google Gemini (free tier)
# ------------------------------------------------------------------------------
# Google AI Studio -> Get API key.
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 6. Live video — LiveKit (free plan)
# ------------------------------------------------------------------------------
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

# ------------------------------------------------------------------------------
# 7. Partner tools (optional)
# ------------------------------------------------------------------------------
# Store prices ("New in stores: from $98"). Hidden if empty.
CHANNEL3_API_KEY=""
# AG Studio license. Not needed for local testing.
AG_STUDIO_LICENSE_KEY=""

# ------------------------------------------------------------------------------
# 8. Judge mode (an always-on demo show at /judge)
# ------------------------------------------------------------------------------
# On by default. Set to "off" to disable the demo seller and the /judge page.
JUDGE_MODE="on"
# A PayPal sandbox PERSONAL (buyer) account shown to judges on /judge (test money only).
JUDGE_PAYPAL_EMAIL=""
JUDGE_PAYPAL_PASSWORD=""

# Recording the demo video: clicking an empty field types its scripted text, the studio's voice
# caption plays the scripted item lines, and simulated viewers join the scripted seller's shows.
# The script (accounts, items, chat lines) is in src/lib/demo-script.ts. Read at build time, so
# restart `npm run dev` (or redeploy) after changing it. Turn it off again once you've recorded.
NEXT_PUBLIC_DEMO_MODE="off"

# ------------------------------------------------------------------------------
# 9. Google sign-in (optional)
# ------------------------------------------------------------------------------
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 10. Email (optional)
# ------------------------------------------------------------------------------
# Without SMTP, emails are printed in the terminal instead.
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="Live Drop <noreply@livedrop.example>"
